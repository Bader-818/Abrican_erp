# ============================================================================
# Abrican ERP — root environment configuration (used by docker-compose.yml)
# Copy this file to `.env` and adjust values for your environment.
# ============================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=abrican
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=abrican_erp
POSTGRES_PORT=5432

# Full connection string used by Prisma (must match the values above)
DATABASE_URL=postgresql://abrican:change_me_postgres_password@db:5432/abrican_erp?schema=public

# --- Backend (NestJS API) ----------------------------------------------------
BACKEND_PORT=3000
NODE_ENV=development

# JWT secrets — generate strong random values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Local file storage root (inside the backend container)
STORAGE_ROOT=/app/storage

# Seeded admin account (created by `prisma/seed.ts`)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@abrican.local
ADMIN_PASSWORD=change_me_admin_password

# --- Frontend (Vite/React SPA) ----------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
