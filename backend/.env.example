# Copy to `.env` for local (non-docker) development.
# When running via docker-compose, these are supplied by the root `.env` file instead.

DATABASE_URL=postgresql://abrican:change_me_postgres_password@localhost:5432/abrican_erp?schema=public

PORT=3000
NODE_ENV=development

# JWT secrets — REQUIRED, no defaults. Generate per environment:
#   openssl rand -hex 32
# Anyone holding JWT_ACCESS_SECRET can forge tokens for any user (pentest P-03).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173

STORAGE_ROOT=./storage

ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@abrican.local
# REQUIRED on a fresh database: the seed never generates or defaults a
# password and fails if this is unset. Store the value privately. The admin
# must set a new password at first login, unless
# ADMIN_FORCE_PASSWORD_CHANGE=false (CI/test environments only).
ADMIN_PASSWORD=
