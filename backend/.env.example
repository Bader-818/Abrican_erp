# Copy to `.env` for local (non-docker) development.
# When running via docker-compose, these are supplied by the root `.env` file instead.

DATABASE_URL=postgresql://abrican:change_me_postgres_password@localhost:5432/abrican_erp?schema=public

PORT=3000
NODE_ENV=development

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173

STORAGE_ROOT=./storage

ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@abrican.local
ADMIN_PASSWORD=change_me_admin_password
