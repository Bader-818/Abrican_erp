// Abrican ERP — Phase 1 Prisma schema
// See abrican_erp_srs_full_prompt.md and the Phase 1 implementation plan for context.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ClientType {
  GOVERNMENT
  SEMI_GOVERNMENT
  PRIVATE
  CONTRACTOR
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CLOSED
  TERMINATED
}

enum PurchaseOrderStatus {
  DRAFT
  ACTIVE
  CONSUMED
  EXPIRED
  CANCELLED
}

enum JobStatus {
  DRAFT
  PLANNED
  APPROVED
  SCHEDULED
  ACTIVE
  ON_HOLD
  COMPLETED
  COSTING_REVIEW
  READY_FOR_INVOICE
  INVOICED
  PARTIALLY_PAID
  PAID
  CLOSED
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE
  ASSIGNED
  ON_LEAVE
  SICK
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum CrewStatus {
  AVAILABLE
  ASSIGNED
  INACTIVE
}

enum CrewMemberStatus {
  ACTIVE
  INACTIVE
}

enum OwnershipType {
  OWNED
  LEASED
  RENTED
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ResourceType {
  EMPLOYEE
  CREW
  VEHICLE
  EQUIPMENT
}

enum AssignmentStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RelatedEntityType {
  EMPLOYEE
  VEHICLE
  EQUIPMENT
  CONTRACT
  CLIENT
  COMPANY
}

enum NotificationType {
  JOB_ASSIGNED
  RESOURCE_CONFLICT
  DOCUMENT_EXPIRING
  DOCUMENT_EXPIRED
  CONTRACT_NEAR_EXPIRY
  PO_NEAR_EXPIRY
  JOB_STATUS_CHANGED
  GENERAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  OVERRIDE
  APPROVE
  REJECT
  TOKEN_REUSE_DETECTED
  PASSWORD_CHANGED
  MFA_ENABLED
  MFA_DISABLED
  ACCOUNT_LOCKED
  SESSION_REVOKED
}

// =============================================================================
// Phase 2 — Finance enums
// =============================================================================

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SUBMITTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// Categorises an estimate/invoice line so labour, equipment, standby, etc. can
// be grouped and (later) cost-compared. Pure presentation/grouping for now.
enum LineKind {
  LABOR
  EQUIPMENT
  MATERIAL
  STANDBY
  OTHER
}

// Billing granularity; mirrors the free-text `unit` on ContractRateCard.
enum BillingUnit {
  HOUR
  DAY
  TRIP
  METER
  UNIT
  LUMP_SUM
}

enum PaymentMethod {
  BANK_TRANSFER
  CHECK
  CASH
  CARD
  OTHER
}

// Approval workflow shared by daily reports, timesheets, and (later) expenses.
// POSTED is used only by expenses (S11).
enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
}

// Expense categories (SRS 850–863).
enum ExpenseCategory {
  LABOR
  VEHICLE
  EQUIPMENT
  MATERIAL
  SUBCONTRACTOR
  ACCOMMODATION
  TRANSPORTATION
  ADMIN
  GOVERNMENT
  FINANCE
  OTHER_DIRECT
  OVERHEAD
}

// Post-approval reimbursement track for employee out-of-pocket expenses (S11).
enum ReimbursementStatus {
  NOT_APPLICABLE
  PENDING
  COMPENSATED
  DELAYED
  DECLINED
}

// =============================================================================
// Identity & Access
// =============================================================================

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  status       UserStatus @default(ACTIVE)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  mustChangePassword  Boolean   @default(false)
  passwordChangedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  jobStatusChanges      JobStatusHistory[]
  assignmentsCreated    JobAssignment[]    @relation("AssignmentCreatedBy")
  documentsUploaded     Document[]         @relation("DocumentUploadedBy")
  estimatesCreated      Estimate[]         @relation("EstimateCreatedBy")
  estimatesApproved     Estimate[]         @relation("EstimateApprovedBy")
  invoicesCreated       Invoice[]          @relation("InvoiceCreatedBy")
  invoicesApproved      Invoice[]          @relation("InvoiceApprovedBy")
  paymentsCreated       Payment[]          @relation("PaymentCreatedBy")
  jobsCostReviewed      Job[]              @relation("JobCostReviewedBy")
  dailyReportsCreated   DailyReport[]      @relation("DailyReportCreatedBy")
  dailyReportsApproved  DailyReport[]      @relation("DailyReportApprovedBy")
  timesheetsCreated     Timesheet[]        @relation("TimesheetCreatedBy")
  timesheetsApproved    Timesheet[]        @relation("TimesheetApprovedBy")
  expensesCreated       Expense[]          @relation("ExpenseCreatedBy")
  expensesApproved      Expense[]          @relation("ExpenseApprovedBy")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  userAgent String?
  ipAddress String?
  lastUsedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =============================================================================
// Clients, Contracts, Purchase Orders
// =============================================================================

model Client {
  id               String       @id @default(uuid())
  name             String
  clientType       ClientType
  vatNumber        String?
  crNumber         String?
  billingAddress   String?
  paymentTermsDays Int?
  status           ClientStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  contacts       ClientContact[]
  contracts      Contract[]
  purchaseOrders PurchaseOrder[]
  jobs           Job[]
  documents      Document[]      @relation("ClientDocuments")
  estimates      Estimate[]
  invoices       Invoice[]
  payments       Payment[]

  @@index([status])
  @@index([clientType])
  @@map("clients")
}

model ClientContact {
  id       String  @id @default(uuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  role     String?
  phone    String?
  email    String?

  @@index([clientId])
  @@map("client_contacts")
}

model Contract {
  id               String         @id @default(uuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id])
  contractNumber   String         @unique
  title            String
  scope            String?
  startDate        DateTime
  endDate          DateTime
  contractValue    Decimal        @db.Decimal(14, 2)
  consumedValue    Decimal        @default(0) @db.Decimal(14, 2)
  paymentTermsDays Int?
  status           ContractStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  rateCards      ContractRateCard[]
  purchaseOrders PurchaseOrder[]
  jobs           Job[]
  documents      Document[]         @relation("ContractDocuments")
  estimates      Estimate[]
  invoices       Invoice[]

  @@index([clientId])
  @@index([status])
  @@index([endDate])
  @@map("contracts")
}

model ContractRateCard {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceLine   String
  itemCode      String?
  description   String
  unit          String
  unitPrice     Decimal  @db.Decimal(12, 2)
  currency      String   @default("SAR")
  vatApplicable Boolean  @default(true)
  effectiveDate DateTime

  estimateLineItems EstimateLineItem[]
  invoiceLineItems  InvoiceLineItem[]

  @@index([contractId])
  @@map("contract_rate_cards")
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  clientId       String
  client         Client              @relation(fields: [clientId], references: [id])
  contractId     String?
  contract       Contract?           @relation(fields: [contractId], references: [id])
  poNumber       String              @unique
  poValue        Decimal             @db.Decimal(14, 2)
  consumedAmount Decimal             @default(0) @db.Decimal(14, 2)
  currency       String              @default("SAR")
  issueDate      DateTime
  expiryDate     DateTime
  status         PurchaseOrderStatus @default(DRAFT)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  jobs     Job[]
  invoices Invoice[]

  @@index([clientId])
  @@index([contractId])
  @@index([status])
  @@index([expiryDate])
  @@map("purchase_orders")
}

// =============================================================================
// Jobs
// =============================================================================

model Job {
  id               String         @id @default(uuid())
  jobCode          String         @unique
  title            String
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id])
  contractId       String?
  contract         Contract?      @relation(fields: [contractId], references: [id])
  purchaseOrderId  String?
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  serviceType      String
  location         String
  region           String?
  plannedStartDate DateTime
  plannedEndDate   DateTime
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  jobValue         Decimal?       @db.Decimal(14, 2)
  costBudget       Decimal?       @db.Decimal(14, 2)
  status           JobStatus      @default(DRAFT)
  description      String?
  // PROFIT (Phase 2 S12) — populated by the costing sprint; null until then.
  actualCost       Decimal?       @db.Decimal(14, 2)
  grossProfit      Decimal?       @db.Decimal(14, 2)
  grossMarginPct   Decimal?       @db.Decimal(6, 2)
  costReviewedAt   DateTime?
  costReviewedById String?
  costReviewedBy   User?          @relation("JobCostReviewedBy", fields: [costReviewedById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  statusHistory JobStatusHistory[]
  assignments   JobAssignment[]
  estimates     Estimate[]
  invoices      Invoice[]
  dailyReports  DailyReport[]
  timesheets    Timesheet[]
  expenses      Expense[]          @relation("ExpenseJob")

  @@index([clientId])
  @@index([contractId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([serviceType])
  @@index([region])
  @@map("jobs")
}

model JobStatusHistory {
  id          String     @id @default(uuid())
  jobId       String
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus  JobStatus?
  toStatus    JobStatus
  changedById String
  changedBy   User       @relation(fields: [changedById], references: [id])
  reason      String?
  createdAt   DateTime   @default(now())

  @@index([jobId])
  @@map("job_status_history")
}

// =============================================================================
// Resources: Employees, Crews, Vehicles, Equipment
// =============================================================================

model Employee {
  id                 String             @id @default(uuid())
  name               String
  role               String
  department         String?
  costRate           Decimal?           @db.Decimal(10, 2)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  phone              String?
  email              String?
  status             EmployeeStatus     @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  crewsSupervised Crew[]          @relation("CrewSupervisor")
  crewMemberships CrewMember[]
  assignments     JobAssignment[] @relation("EmployeeAssignments")
  documents       Document[]      @relation("EmployeeDocuments")
  dailyReports    DailyReport[]   @relation("DailyReportSupervisor")
  timesheets      Timesheet[]     @relation("TimesheetEmployee")
  expenses        Expense[]       @relation("ExpenseEmployee")

  @@index([status])
  @@index([availabilityStatus])
  @@map("employees")
}

model Crew {
  id                String     @id @default(uuid())
  name              String
  supervisorId      String?
  supervisor        Employee?  @relation("CrewSupervisor", fields: [supervisorId], references: [id])
  serviceCapability String?
  status            CrewStatus @default(AVAILABLE)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  members     CrewMember[]
  assignments JobAssignment[] @relation("CrewAssignments")
  timesheets  Timesheet[]     @relation("TimesheetCrew")

  @@index([supervisorId])
  @@index([status])
  @@map("crews")
}

model CrewMember {
  id         String           @id @default(uuid())
  crewId     String
  crew       Crew             @relation(fields: [crewId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  startDate  DateTime
  endDate    DateTime?
  status     CrewMemberStatus @default(ACTIVE)

  @@index([crewId])
  @@index([employeeId])
  @@map("crew_members")
}

model Vehicle {
  id                 String        @id @default(uuid())
  plateNumber        String        @unique
  vehicleType        String
  make               String?
  model              String?
  year               Int?
  ownershipType      OwnershipType
  status             VehicleStatus @default(AVAILABLE)
  odometer           Int?
  fuelType           String?
  registrationExpiry DateTime?
  insuranceExpiry    DateTime?
  inspectionExpiry   DateTime?
  costRate           Decimal?      @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  assignments JobAssignment[] @relation("VehicleAssignments")
  documents   Document[]      @relation("VehicleDocuments")
  expenses    Expense[]       @relation("ExpenseVehicle")

  @@index([status])
  @@map("vehicles")
}

model Equipment {
  id                 String          @id @default(uuid())
  name               String
  equipmentType      String
  serialNumber       String?
  status             EquipmentStatus @default(AVAILABLE)
  ownershipType      OwnershipType
  costRate           Decimal?        @db.Decimal(10, 2)
  currentLocation    String?
  calibrationExpiry  DateTime?
  maintenanceDueDate DateTime?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  assignments JobAssignment[] @relation("EquipmentAssignments")
  documents   Document[]      @relation("EquipmentDocuments")
  expenses    Expense[]       @relation("ExpenseEquipment")

  @@index([status])
  @@map("equipment")
}

// =============================================================================
// Assignments (polymorphic: exactly one of employee/crew/vehicle/equipment)
// =============================================================================

model JobAssignment {
  id             String           @id @default(uuid())
  jobId          String
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resourceType   ResourceType
  employeeId     String?
  employee       Employee?        @relation("EmployeeAssignments", fields: [employeeId], references: [id])
  crewId         String?
  crew           Crew?            @relation("CrewAssignments", fields: [crewId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?         @relation("VehicleAssignments", fields: [vehicleId], references: [id])
  equipmentId    String?
  equipment      Equipment?       @relation("EquipmentAssignments", fields: [equipmentId], references: [id])
  startDatetime  DateTime
  endDatetime    DateTime
  plannedHours   Decimal?         @db.Decimal(8, 2)
  actualHours    Decimal?         @db.Decimal(8, 2)
  status         AssignmentStatus @default(PLANNED)
  overrideReason String?
  createdById    String
  createdBy      User             @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([jobId])
  @@index([employeeId])
  @@index([crewId])
  @@index([vehicleId])
  @@index([equipmentId])
  @@index([status])
  @@index([startDatetime, endDatetime])
  @@map("job_assignments")
}

// =============================================================================
// Documents (polymorphic: at most one of employee/vehicle/equipment/contract/client)
// =============================================================================

model Document {
  id                String            @id @default(uuid())
  relatedEntityType RelatedEntityType
  employeeId        String?
  employee          Employee?         @relation("EmployeeDocuments", fields: [employeeId], references: [id])
  vehicleId         String?
  vehicle           Vehicle?          @relation("VehicleDocuments", fields: [vehicleId], references: [id])
  equipmentId       String?
  equipment         Equipment?        @relation("EquipmentDocuments", fields: [equipmentId], references: [id])
  contractId        String?
  contract          Contract?         @relation("ContractDocuments", fields: [contractId], references: [id])
  clientId          String?
  client            Client?           @relation("ClientDocuments", fields: [clientId], references: [id])
  documentType      String
  issueDate         DateTime?
  expiryDate        DateTime?
  fileUrl           String
  notes             String?
  uploadedById      String
  uploadedBy        User              @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt         DateTime          @default(now())

  @@index([relatedEntityType])
  @@index([employeeId])
  @@index([vehicleId])
  @@index([equipmentId])
  @@index([contractId])
  @@index([clientId])
  @@index([expiryDate])
  @@map("documents")
}

// =============================================================================
// Audit Log & Notifications
// =============================================================================

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  comment    String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  message           String
  isRead            Boolean          @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// =============================================================================
// Phase 2 — Finance: Estimates / Quotations
// =============================================================================

model Estimate {
  id               String         @id @default(uuid())
  estimateNumber   String         @unique
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id])
  contractId       String?
  contract         Contract?      @relation(fields: [contractId], references: [id])
  jobId            String?        // set when the approved estimate is converted to a job
  job              Job?           @relation(fields: [jobId], references: [id])
  title            String
  jobType          String
  location         String
  plannedStartDate DateTime
  plannedEndDate   DateTime
  currency         String         @default("SAR")
  status           EstimateStatus @default(DRAFT)
  validUntil       DateTime?
  notes            String?
  // PRICE — the quoted figures (derived from line items).
  subtotal         Decimal        @default(0) @db.Decimal(14, 2)
  vatAmount        Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal        @default(0) @db.Decimal(14, 2)
  // PROFIT (S12) — populated later from costRate; null for now.
  estimatedCost      Decimal?     @db.Decimal(14, 2)
  estimatedMarginPct Decimal?     @db.Decimal(6, 2)
  pdfUrl           String?
  createdById      String
  createdBy        User           @relation("EstimateCreatedBy", fields: [createdById], references: [id])
  approvedById     String?
  approvedBy       User?          @relation("EstimateApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  lineItems EstimateLineItem[]
  invoices  Invoice[]

  @@index([clientId])
  @@index([status])
  @@index([jobId])
  @@map("estimates")
}

model EstimateLineItem {
  id                 String            @id @default(uuid())
  estimateId         String
  estimate           Estimate          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  contractRateCardId String?
  rateCard           ContractRateCard? @relation(fields: [contractRateCardId], references: [id])
  lineKind           LineKind          @default(OTHER)
  description        String
  quantity           Decimal           @db.Decimal(12, 2)  // # personnel / # equipment units
  hours              Decimal           @default(1) @db.Decimal(12, 2)  // man-hours / equipment-hours (1 for lump sum)
  unit               BillingUnit       @default(HOUR)
  unitPrice          Decimal           @db.Decimal(12, 2)  // SELLING rate
  vatRate            Decimal           @default(15) @db.Decimal(5, 2)
  lineSubtotal       Decimal           @db.Decimal(14, 2)  // quantity * hours * unitPrice
  lineVat            Decimal           @db.Decimal(14, 2)
  lineTotal          Decimal           @db.Decimal(14, 2)
  // PROFIT (S12)
  estimatedUnitCost  Decimal?          @db.Decimal(12, 2)
  lineCost           Decimal?          @db.Decimal(14, 2)
  sortOrder          Int               @default(0)

  invoiceLineItems InvoiceLineItem[]

  @@index([estimateId])
  @@map("estimate_line_items")
}

// =============================================================================
// Phase 2 — Finance: Invoices
// =============================================================================

model Invoice {
  id                String         @id @default(uuid())
  uuid              String         @unique @default(uuid())  // ZATCA-ready identifier
  invoiceNumber     String         @unique
  estimateId        String?
  estimate          Estimate?      @relation(fields: [estimateId], references: [id])
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  contractId        String?
  contract          Contract?      @relation(fields: [contractId], references: [id])
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  jobId             String?
  job               Job?           @relation(fields: [jobId], references: [id])
  clientVatNumber   String?
  billingAddress    String?
  servicePeriodFrom DateTime?
  servicePeriodTo   DateTime?
  invoiceDate       DateTime
  dueDate           DateTime
  currency          String         @default("SAR")
  subtotal          Decimal        @default(0) @db.Decimal(14, 2)
  vatAmount         Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount       Decimal        @default(0) @db.Decimal(14, 2)
  paidAmount        Decimal        @default(0) @db.Decimal(14, 2)
  outstandingAmount Decimal        @default(0) @db.Decimal(14, 2)
  status            InvoiceStatus  @default(DRAFT)
  zatcaStatus       String?        // Phase 3 placeholder
  notes             String?
  pdfUrl            String?
  createdById       String
  createdBy         User           @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  approvedById      String?
  approvedBy        User?          @relation("InvoiceApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  submittedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([clientId])
  @@index([status])
  @@index([jobId])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id                       String            @id @default(uuid())
  invoiceId                String
  invoice                  Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceEstimateLineItemId String?
  sourceEstimateLineItem   EstimateLineItem? @relation(fields: [sourceEstimateLineItemId], references: [id])
  contractRateCardId       String?
  rateCard                 ContractRateCard? @relation(fields: [contractRateCardId], references: [id])
  lineKind                 LineKind          @default(OTHER)
  description              String
  quantity                 Decimal           @db.Decimal(12, 2)  // ACTUAL quantity
  hours                    Decimal           @default(1) @db.Decimal(12, 2)  // ACTUAL hours
  unit                     BillingUnit       @default(HOUR)
  unitPrice                Decimal           @db.Decimal(12, 2)
  vatRate                  Decimal           @default(15) @db.Decimal(5, 2)
  lineSubtotal             Decimal           @db.Decimal(14, 2)
  lineVat                  Decimal           @db.Decimal(14, 2)
  lineTotal                Decimal           @db.Decimal(14, 2)
  sortOrder                Int               @default(0)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// =============================================================================
// Phase 2 — Finance: Payments
// =============================================================================

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  paymentDate     DateTime
  amount          Decimal       @db.Decimal(14, 2)
  method          PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?
  createdById     String
  createdBy       User          @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([invoiceId])
  @@index([clientId])
  @@index([paymentDate])
  @@map("payments")
}

// =============================================================================
// Phase 2 — Field data: Daily Reports & Timesheets (S10)
// =============================================================================

model DailyReport {
  id              String         @id @default(uuid())
  jobId           String
  job             Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reportDate      DateTime
  supervisorId    String?
  supervisor      Employee?      @relation("DailyReportSupervisor", fields: [supervisorId], references: [id])
  workPerformed   String
  progressPct     Decimal?       @db.Decimal(5, 2)
  clientRep       String?
  weather         String?
  issues          String?
  materialsUsed   String?
  equipmentUsed   String?
  vehiclesUsed    String?
  approvalStatus  ApprovalStatus @default(DRAFT)
  approvedById    String?
  approvedBy      User?          @relation("DailyReportApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String
  createdBy       User           @relation("DailyReportCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([jobId])
  @@index([approvalStatus])
  @@index([reportDate])
  @@map("daily_reports")
}

model Timesheet {
  id              String         @id @default(uuid())
  jobId           String
  job             Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employeeId      String?
  employee        Employee?      @relation("TimesheetEmployee", fields: [employeeId], references: [id])
  crewId          String?
  crew            Crew?          @relation("TimesheetCrew", fields: [crewId], references: [id])
  workDate        DateTime
  regularHours    Decimal        @default(0) @db.Decimal(6, 2)
  overtimeHours   Decimal        @default(0) @db.Decimal(6, 2)
  standbyHours    Decimal        @default(0) @db.Decimal(6, 2)
  travelHours     Decimal        @default(0) @db.Decimal(6, 2)
  notes           String?
  approvalStatus  ApprovalStatus @default(DRAFT)
  approvedById    String?
  approvedBy      User?          @relation("TimesheetApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String
  createdBy       User           @relation("TimesheetCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([jobId])
  @@index([employeeId])
  @@index([crewId])
  @@index([approvalStatus])
  @@index([workDate])
  @@map("timesheets")
}

// Direct & overhead costs (S11). Approval workflow mirrors timesheets; once an
// out-of-pocket (reimbursable) expense is approved a manager works the
// reimbursement track to compensate/delay/decline the employee who paid.
model Expense {
  id              String              @id @default(uuid())
  expenseDate     DateTime
  vendor          String?
  category        ExpenseCategory
  description     String?
  amountBeforeVat Decimal             @db.Decimal(14, 2)
  vatAmount       Decimal             @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal             @db.Decimal(14, 2)
  currency        String              @default("SAR")

  approvalStatus  ApprovalStatus      @default(DRAFT)
  approvedById    String?
  approvedBy      User?               @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  postedAt        DateTime?

  // Allocation — all optional (no Department model yet; departmentId omitted).
  jobId           String?
  job             Job?                @relation("ExpenseJob", fields: [jobId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?            @relation("ExpenseVehicle", fields: [vehicleId], references: [id])
  equipmentId     String?
  equipment       Equipment?          @relation("ExpenseEquipment", fields: [equipmentId], references: [id])
  employeeId      String?
  employee        Employee?           @relation("ExpenseEmployee", fields: [employeeId], references: [id])

  // Receipt — stored via IStorageService (not the generic Document module).
  receiptUrl      String?
  receiptName     String?

  // Reimbursement track (employee out-of-pocket).
  reimbursable        Boolean             @default(false)
  reimbursementStatus ReimbursementStatus @default(NOT_APPLICABLE)
  reimbursedAt        DateTime?
  reimbursementNote   String?
  reimbursementMethod PaymentMethod?
  reimbursementRef    String?

  createdById     String
  createdBy       User                @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([jobId])
  @@index([employeeId])
  @@index([vehicleId])
  @@index([equipmentId])
  @@index([category])
  @@index([approvalStatus])
  @@index([reimbursementStatus])
  @@index([expenseDate])
  @@map("expenses")
}
