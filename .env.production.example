# =============================================================================
# Production environment for docker-compose.prod.yml
# Copy to `.env.production` and fill in REAL values. Never commit the real file.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# =============================================================================

# --- Database (internal to the docker network; no public port) ---------------
POSTGRES_USER=abrican
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=abrican_erp

# Must use the internal service host `db` and port 5432.
DATABASE_URL=postgresql://abrican:CHANGE_ME_postgres_password@db:5432/abrican_erp?schema=public

# --- Auth secrets (generate each with: openssl rand -hex 32) ------------------
JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- First admin (created on first boot by the seed) -------------------------
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@yourcompany.com
# Generate a strong one and change it after first login.
ADMIN_PASSWORD=CHANGE_ME_admin_password

# Re-run the seed on every container start (idempotent). Set to false once the
# database is established if you don't want demo data re-checked.
SEED_ON_START=true

# --- Web ---------------------------------------------------------------------
# Public web port published by the frontend container. Keep 80 if a TLS proxy
# sits in front; use e.g. 8080 for a local prod test.
HTTP_PORT=80

# Your public site origin, used for CORS. Same-origin deploys (nginx proxies
# /api) don't strictly need it, but set it to be safe.
CORS_ORIGINS=https://erp.yourcompany.com

# Where the SPA sends API calls. Leave as /api/v1 for the same-origin setup.
VITE_API_BASE_URL=/api/v1
